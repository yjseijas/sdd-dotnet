{
  "openapi": "3.1.0",
  "info": {
    "title": "API de listado de propiedades",
    "version": "1.0.0",
    "description": "Contrato del listado paginado de propiedades."
  },
  "paths": {
    "/api/properties": {
      "get": {
        "operationId": "listProperties",
        "summary": "Listar propiedades de forma paginada",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Número de página, comenzando en 1.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "Cantidad máxima de elementos por página.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 6
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de propiedades y metadatos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedPropertiesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Parámetros de paginación inválidos.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PropertyListItem": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "address",
          "price",
          "status",
          "bedroomCount",
          "bathroomCount",
          "areaSquareMeters",
          "imageUrl"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "Available",
              "Rented",
              "Maintenance"
            ]
          },
          "bedroomCount": {
            "type": "integer"
          },
          "bathroomCount": {
            "type": "integer"
          },
          "areaSquareMeters": {
            "type": "number"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://.+/assets/properties/[^/]+$"
          }
        }
      },
      "PagedPropertiesResponse": {
        "type": "object",
        "required": [
          "items",
          "page",
          "pageSize",
          "totalItems",
          "totalPages",
          "hasNext",
          "hasPrevious"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PropertyListItem"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "totalItems": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "hasNext": {
            "type": "boolean"
          },
          "hasPrevious": {
            "type": "boolean"
          }
        }
      },
      "ValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "const": 400
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
